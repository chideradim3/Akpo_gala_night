{
  "name": "gala_night_sales",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/db.mjs push",
    "db:seed": "node scripts/db.mjs seed",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/db.mjs types",
    "test:db": "node scripts/test-inventory-race.mjs && node scripts/test-rls.mjs",
    "test:checkout": "node scripts/test-checkout-flow.mjs",
    "test:all": "npm test && npm run test:db",
    "db:status": "node scripts/db.mjs status",
    "simulate-payment": "node scripts/simulate-payment.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "test-email": "node scripts/test-email.mjs",
    "audit:security": "node scripts/security-audit.mjs",
    "audit:responsive": "node scripts/responsive-audit.mjs",
    "audit": "npm run audit:security && npm run audit:responsive"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "next": "16.3.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  }
}
