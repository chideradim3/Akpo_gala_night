# ─────────────────────────────────────────────────────────────────────────────
# Gala Night — environment variables
#
# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local
#
# `.env.local` is gitignored. NEVER commit real values.
# Anything prefixed NEXT_PUBLIC_ is sent to the browser and is NOT a secret.
# Everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Phase 2 — Supabase ───────────────────────────────────────────────────────
# From your Supabase dashboard: Project Settings -> API. See SUPABASE_SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. This key bypasses Row Level Security — it can read and write
# every row in the database. Never import it into a client component, never
# prefix it with NEXT_PUBLIC_, never paste it anywhere public.
SUPABASE_SERVICE_ROLE_KEY=

# ── Phase 4 — bot protection (Cloudflare Turnstile) ──────────────────────────
# Leave BOTH blank in development: the checkout then skips the bot check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Phase 5 — payment boundary ───────────────────────────────────────────────
# Absolute URL of this site, used to build the payment return URL.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# mock = the built-in dev simulator at /dev/mock-payment
# real = the payment developer's implementation in lib/services/payment/real.ts
PAYMENT_PROVIDER=mock

# Shared secret for the X-Signature (HMAC-SHA256) header on
# POST /api/payments/confirm. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Give the same value to the payment developer. See PAYMENT_INTEGRATION.md.
PAYMENT_CONFIRM_SECRET=

# ── Phase 6 — email delivery ─────────────────────────────────────────────────
# console = print the email to the terminal instead of sending (dev default)
# resend  = actually send via Resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Must be an address on a domain verified with your email provider.
EMAIL_FROM="Gala Night <tickets@example.com>"
